5
(
    inlet
    {
        type            patch;
        nFaces          200;
        startFace       127480;
    }
    outlet
    {
        type            patch;
        nFaces          200;
        startFace       127680;
    }
    top
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          320;
        startFace       127880;
    }
    bottom
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          320;
        startFace       128200;
    }
    defaultFaces
    {
        type            empty;
        inGroups        1(empty);
        nFaces          128000;
        startFace       128520;
    }
)

